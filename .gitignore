# AgenticLex (ClaudeCodeLex) — .gitignore
#
# The Xcode project is generated by XcodeGen. `project.yml` is the source of
# truth; `.xcodeproj` and the generated `Info.plist` are derived artifacts and
# are NOT tracked. After cloning, run `xcodegen generate` to (re)create them.

# --- XcodeGen-generated artifacts ---
*.xcodeproj/
ClaudeCodeLex/Info.plist

# --- Xcode build / user state ---
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# --- Generated assets (regenerate via tools/) ---
# App Store screenshots — tools/shoot_screenshots.sh + render_screenshots.swift.
outputs/

# --- Swift Package Manager ---
.build/
.swiftpm/
Package.resolved

# --- macOS ---
.DS_Store
*.swp

# --- misc ---
*.log
__pycache__/
*.pyc

# Cloudflare Pages local cache
site/.wrangler/

# Feedback ops state/logs (owner-side; tools/fetch_reviews.py)
tools/.feedback/
