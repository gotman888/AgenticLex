// Aviso de envio de dados para IA (Apple Guideline 5.1.1(i) / 5.1.2(i))
"aidisclosure.nav.title" = "Aviso de envio de dados para IA";
"aidisclosure.header.title" = "Leia antes de usar funções de IA";
"aidisclosure.header.body" = "Para cumprir as normas de revisão de privacidade da Apple, devemos informar claramente quais dados são enviados, para quem e com que finalidade antes que você use qualquer função de IA.";
"aidisclosure.sec.send.title" = "O que enviamos";
"aidisclosure.sec.send.body" = "Apenas as **mensagens de texto** que você digita e envia ao assistente de IA no AgenticLex. Em conversas de múltiplos turnos, também é enviado o histórico necessário para a IA manter o contexto.";
"aidisclosure.sec.recipients.title" = "Quem recebe os dados";
"aidisclosure.sec.recipients.body" = "Conforme os provedores que você ativar em «Ajustes → AI Boost», até quatro serviços de IA de terceiros podem receber seu input:\n\n• **Anthropic, PBC** (San Francisco, CA, EUA) — Claude API para conversa com IA\n• **OpenAI, L.L.C.** (San Francisco, CA, EUA) — GPT para conversa; TTS para reprodução de voz\n• **Google LLC** (Mountain View, CA, EUA) — Gemini API para conversa com IA\n• **ElevenLabs Inc.** (Nova York, NY, EUA) — TTS para reprodução de voz\n\nSomente os provedores que você configurar ativamente com sua própria chave de API recebem dados. Nenhum dado é enviado a provedores que você não tenha ativado.";
"aidisclosure.sec.purpose.title" = "Finalidade";
"aidisclosure.sec.purpose.body" = "**Somente para gerar a resposta de IA da sua solicitação atual.** Por padrão, nenhum provedor usa dados da API para treinar modelos; os dados são retidos brevemente (até ~30 dias) para detecção de abuso e então excluídos.";
"aidisclosure.sec.notSent.title" = "Dados que NÃO enviamos";
"aidisclosure.sec.notSent.body" = "Seu Apple ID, identificador do aparelho, nome, contatos, localização, fotos e IDFA nunca são transmitidos. Todas as transmissões usam criptografia TLS.";
