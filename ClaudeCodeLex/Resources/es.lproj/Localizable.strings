// Aviso de envio de datos a IA (Apple Guideline 5.1.1(i) / 5.1.2(i))
"aidisclosure.nav.title" = "Aviso de envío de datos a IA";
"aidisclosure.header.title" = "Por favor lee antes de usar funciones de IA";
"aidisclosure.header.body" = "Para cumplir con las normas de revisión de privacidad de Apple, debemos informarte claramente qué datos se envían, a quién y para qué antes de que uses cualquier función de IA.";
"aidisclosure.sec.send.title" = "Qué enviamos";
"aidisclosure.sec.send.body" = "Solo los **mensajes de texto** que escribes y envías al asistente de IA en AgenticLex. En conversaciones de múltiples turnos, también se envía el historial necesario para que la IA mantenga el contexto.";
"aidisclosure.sec.recipients.title" = "Quién recibe los datos";
"aidisclosure.sec.recipients.body" = "Según los proveedores que actives en «Ajustes → AI Boost», hasta cuatro servicios de IA de terceros pueden recibir tu entrada:\n\n• **Anthropic, PBC** (San Francisco, CA, EE. UU.) — Claude API para conversación con IA\n• **OpenAI, L.L.C.** (San Francisco, CA, EE. UU.) — GPT para conversación; TTS para reproducción de voz\n• **Google LLC** (Mountain View, CA, EE. UU.) — Gemini API para conversación con IA\n• **ElevenLabs Inc.** (Nueva York, NY, EE. UU.) — TTS para reproducción de voz\n\nSolo los proveedores que configures activamente con tu propia clave de API reciben datos. No se envían datos a proveedores que no hayas activado.";
"aidisclosure.sec.purpose.title" = "Finalidad";
"aidisclosure.sec.purpose.body" = "**Únicamente para generar la respuesta de IA a tu solicitud actual.** Por defecto, ningún proveedor usa los datos de la API para entrenar modelos; los datos se conservan brevemente (hasta ~30 días) para detección de abuso y luego se eliminan.";
"aidisclosure.sec.notSent.title" = "Datos que NO enviamos";
"aidisclosure.sec.notSent.body" = "Tu Apple ID, identificador de dispositivo, nombre, contactos, ubicación, fotos e IDFA nunca se transmiten. Todas las transmisiones usan cifrado TLS.";
"aidisclosure.sec.choice.title" = "Tu elección";
"aidisclosure.sec.choice.body" = "Elegir «**No acepto**» desactiva las funciones de IA pero mantiene el resto de la app totalmente utilizable.\n\nPuedes retirar tu consentimiento en cualquier momento en **Ajustes → Privacidad → Consentimiento de envío de datos a IA**.";
