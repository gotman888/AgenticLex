// AI disclosure (Apple Guideline 5.1.1(i) / 5.1.2(i))
"aidisclosure.nav.title" = "AI Data Sharing Notice";
"aidisclosure.header.title" = "Please read before using AI features";
"aidisclosure.header.body" = "To meet Apple's privacy review requirements, we must clearly tell you what data is sent, who receives it, and how it is used before you use any AI feature.";
"aidisclosure.sec.send.title" = "What we send";
"aidisclosure.sec.send.body" = "Only the **text** you type and submit to the AI assistant. In multi-turn conversations, the necessary chat history is also sent so the AI can stay on topic.";
"aidisclosure.sec.recipients.title" = "Who receives the data";
"aidisclosure.sec.recipients.body" = "Up to four third-party AI services may receive your input, depending on which provider you enable in Settings → AI Boost:\n\n• **Anthropic, PBC** (San Francisco, CA, USA) — Claude API for AI conversation\n• **OpenAI, L.L.C.** (San Francisco, CA, USA) — GPT for AI conversation; TTS for voice playback\n• **Google LLC** (Mountain View, CA, USA) — Gemini API for AI conversation\n• **ElevenLabs Inc.** (New York, NY, USA) — TTS for voice playback\n\nOnly providers you actively configure with your own API key receive any data. No data is sent to providers you have not enabled.";
"aidisclosure.sec.purpose.title" = "Purpose";
"aidisclosure.sec.purpose.body" = "**Only to generate your AI response for the current request.** Each provider's default policy is not to use API data for model training; data is retained briefly (up to ~30 days) for safety and abuse detection, then deleted.";
"aidisclosure.sec.notSent.title" = "What we do NOT send";
"aidisclosure.sec.notSent.body" = "Your Apple ID, device identifier, name, contact info, location, contacts, photos and IDFA are never transmitted. All transmissions use TLS encryption.";
"aidisclosure.sec.choice.title" = "Your choice";
"aidisclosure.sec.choice.body" = "Choosing **Disagree** disables AI features while keeping every other part of the app fully usable.\n\nYou can withdraw consent any time under **Settings → Privacy → AI data sharing consent**.";
"aidisclosure.button.privacy" = "View full Privacy Policy";
"aidisclosure.button.agree" = "Agree and Continue";
"aidisclosure.button.decline" = "Disagree, disable AI features";
